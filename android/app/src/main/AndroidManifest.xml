<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- Push notifications: a white S in the status bar (a full-colour icon would show as a plain white square). -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_saligue" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/notification_accent" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Links to Saligue sent in WhatsApp, messages or anywhere else open the app on the page they point
                 at, like every other social app, instead of a browser tab. Android checks that this app really owns
                 the address by reading https://<host>/.well-known/assetlinks.json and comparing it with the key this
                 build is signed with; if that check ever fails, links simply open in a browser as they do now.

                 The paths are listed one by one on purpose. A filter with no path claims EVERY address on the host,
                 and that included /download — which a phone answered by opening this app, whose window cannot save a
                 file, so the download link did nothing at all on any phone that had Saligue installed. App Links has
                 no way to exclude one path from a wildcard, so the shared pages are named instead and /download is
                 left to the browser. Adding a page people share means adding its prefix here. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="78-47-151-100.sslip.io" android:path="/" />
                <data android:scheme="https" android:host="78-47-151-100.sslip.io" android:pathPrefix="/product" />
                <data android:scheme="https" android:host="78-47-151-100.sslip.io" android:pathPrefix="/indeciana" />
                <data android:scheme="https" android:host="78-47-151-100.sslip.io" android:pathPrefix="/looks" />
                <data android:scheme="https" android:host="78-47-151-100.sslip.io" android:pathPrefix="/live" />
                <data android:scheme="https" android:host="78-47-151-100.sslip.io" android:pathPrefix="/learn" />
                <data android:scheme="https" android:host="78-47-151-100.sslip.io" android:pathPrefix="/challenge" />
                <data android:scheme="https" android:host="78-47-151-100.sslip.io" android:pathPrefix="/profile" />
                <data android:scheme="https" android:host="78-47-151-100.sslip.io" android:pathPrefix="/me" />
                <data android:scheme="https" android:host="78-47-151-100.sslip.io" android:pathPrefix="/tag" />
                <data android:scheme="https" android:host="78-47-151-100.sslip.io" android:pathPrefix="/register" />
                <data android:scheme="https" android:host="78-47-151-100.sslip.io" android:pathPrefix="/invite" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Saligue Live (camera and microphone in the app) and Fitting Room photos. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
