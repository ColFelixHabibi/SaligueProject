rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Signed in with an email or Google account (not a silent guest).
    function isRegistered() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // INDECIANA's official accounts. The flag is set by an administrator (Firebase console), never by the app.
    function isOfficial() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('official', false) == true;
    }

    // Product photos are stored inline (see src/lib/image.ts), so cap their size.
    // A document is limited to 1 MiB in total.
    function isValidProduct(p) {
      return p.name is string && p.name.size() > 0 && p.name.size() <= 200
        && p.price is number && p.price >= 0
        && p.image is string && p.image.size() <= 500000
        && (!('cutout' in p) || (p.cutout is string && p.cutout.size() <= 400000))
        && (!('embedding' in p) || (p.embedding is list && p.embedding.size() <= 1024))
        && p.category is string && p.category.size() <= 60
        && p.status in ['active', 'archived', 'draft']
        && p.sellerId == request.auth.uid
        && (p.get('official', false) == false || isOfficial());
    }

    // Marketplace listings: public to read, only the seller who listed an item can change it.
    match /products/{productId} {
      function likePath() {
        return /databases/$(database)/documents/products/$(productId)/likes/$(request.auth.uid);
      }
      function likeCountAfter() {
        return getAfter(/databases/$(database)/documents/products/$(productId)).data.get('likeCount', 0);
      }
      function likeCountBefore() {
        return get(/databases/$(database)/documents/products/$(productId)).data.get('likeCount', 0);
      }
      // Anyone (guests too) may move likeCount by one, together with their own like document.
      function isLikeChange() {
        return signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
          && ((request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1 && existsAfter(likePath()) && !exists(likePath()))
            || (request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1 && !existsAfter(likePath()) && exists(likePath())));
      }

      allow read: if true;
      allow create: if isRegistered() && isValidProduct(request.resource.data);
      allow update: if (isUser(resource.data.sellerId) && isValidProduct(request.resource.data)) || isLikeChange();
      allow delete: if isUser(resource.data.sellerId);

      match /likes/{uid} {
        allow read: if true;
        allow create: if isUser(uid) && request.resource.data.uid == uid && likeCountAfter() == likeCountBefore() + 1;
        allow delete: if isUser(uid) && likeCountAfter() == likeCountBefore() - 1;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 60;
        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/products/$(productId)).data.sellerId == request.auth.uid);
      }
    }

    // "Which items did I like?" across all products.
    match /{path=**}/likes/{uid} {
      allow read: if true;
    }

    // Each user's profile (role), cart and wishlist are private to them.
    match /users/{uid} {
      allow read: if isUser(uid);
      allow create: if isUser(uid)
        && (!('role' in request.resource.data) || request.resource.data.role in ['buyer', 'seller'])
        && request.resource.data.get('official', false) == false;
      // Users can edit their role and shop, but not make themselves official.
      allow update: if isUser(uid)
        && (!('role' in request.resource.data) || request.resource.data.role in ['buyer', 'seller'])
        && request.resource.data.get('official', false) == resource.data.get('official', false);

      match /cart/{productId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && request.resource.data.quantity is int
          && request.resource.data.quantity > 0
          && request.resource.data.quantity <= 99;
      }

      match /wishlist/{productId} {
        allow read, write: if isUser(uid);
      }
    }

    // Orders: one per shop. Buyers create them and may cancel while still "placed";
    // the shop updates the delivery and payment status.
    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.status == 'placed'
        && request.resource.data.paymentStatus == 'unpaid'
        && request.resource.data.paymentMethod in ['mobile_money', 'cash_on_delivery', 'pickup'];
      allow update: if signedIn() && (
        (resource.data.sellerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentStatus'])
          && request.resource.data.status in ['placed', 'confirmed', 'shipped', 'delivered', 'cancelled']
          && request.resource.data.paymentStatus in ['unpaid', 'paid'])
        || (resource.data.buyerId == request.auth.uid
          && resource.data.status == 'placed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled')
      );
    }

    // App settings such as the Saligue AI Studio address; readable by all, set by INDECIANA.
    match /config/{name} {
      allow read: if true;
      allow write: if isOfficial();
    }

    // Support requests can be sent by signed-in users; they are read in the Firebase console.
    match /supportRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 5000;
    }
  }
}
